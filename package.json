{
  "name": "@molarverse/pq-design",
  "version": "0.1.3",
  "description": "Flat-mono design language (tokens, base styles, React primitives) shared by PQSetup, PQViewer and PQEnalyzer.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/MolarVerse/PQDesign.git"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./tokens.json": "./tokens.json",
    "./terminal.py": "./python/pq_terminal.py"
  },
  "files": [
    "dist",
    "src/styles",
    "scripts",
    "tokens.json",
    "python/pq_terminal.py",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --external:lucide-react --outfile=dist/index.js",
    "tokens": "node scripts/build-tokens.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
